# CodeTogether Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codetogether?retryWrites=true&w=majority

# JSON Web Token Secret (Required in production, minimum 32 random characters)
JWT_SECRET=codetogether_super_secure_jwt_secret_key_2026

# Allowed Frontend Client Origin for CORS and Socket.IO
CLIENT_URL=http://localhost:5173

# WebRTC STUN Server (Public default)
STUN_SERVER=stun:stun.l.google.com:19302

# Optional WebRTC TURN Server (For NAT traversal across restrictive corporate/mobile firewalls)
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=
